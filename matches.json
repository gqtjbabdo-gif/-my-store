import requests
from bs4 import BeautifulSoup
import json

# URL of the competition page
url = "https://native-stats.org/competition/fifa-world-cup/2026"

# Fetching the webpage content
try:
    response = requests.get(url)
    soup = BeautifulSoup(response.content, 'html.parser')
    
    all_matches = []
    
    # Searching for table rows
    rows = soup.find_all('tr')
    
    for row in rows:
        columns = row.find_all('td')
        # Ensure the row contains data (at least 3 columns)
        if len(columns) >= 3:
            match_data = {
                "teams": columns[1].text.strip(),
                "score": columns[2].text.strip(),
                "date": columns[0].text.strip()
            }
            all_matches.append(match_data)
    
    # Saving data to JSON
    with open('matches.json', 'w', encoding='utf-8') as f:
        json.dump(all_matches, f, ensure_ascii=False, indent=4)
        
    print("Data successfully updated!")

except Exception as e:
    print(f"Error occurred: {e}")
